# Supabase Configuration
# Supabase 대시보드 > Project Settings > API 에서 확인 가능한 값들을 입력하세요.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage Bucket Name
SUPABASE_STORAGE_BUCKET=waste-photos

# 대형폐기물 수수료 수납 계좌 (계좌이체 전용)
# 시에서 실제 시 지정 계좌로 교체하세요. 아래 값은 자리표시자이며 실제 개인 계좌가 아닙니다.
# 파일을 쓰지 않으면 payment-account.json 값을 사용합니다.
PAYMENT_BANK_NAME=(시 지정 은행 — 교체 필요)
PAYMENT_ACCOUNT_HOLDER=제천시 (대형폐기물 수수료) — 교체 필요
PAYMENT_ACCOUNT_NUMBER=000-00-000000
